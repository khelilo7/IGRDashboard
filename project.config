[access]
	inheritFrom = All-Projects
[submit]
[access "refs/*"]
	owner = group user/Khalil jridi (khelilo7)
[access "refs/for/refs/*"]
	label-Code-Review = -2..+2 group user/Khalil jridi (khelilo7)
	label-Verified = -1..+1 group user/Khalil jridi (khelilo7)
	push = group user/Khalil jridi (khelilo7)
	read = group user/Khalil jridi (khelilo7)
	rebase = group user/Khalil jridi (khelilo7)
	removeReviewer = group user/Khalil jridi (khelilo7)
	submit = group user/Khalil jridi (khelilo7)
[access "refs/heads/*"]
	create = group user/Khalil jridi (khelilo7)
	push = +force group user/Khalil jridi (khelilo7)
	pushMerge = group user/Khalil jridi (khelilo7)
	read = group user/Khalil jridi (khelilo7)
[access "refs/tags/*"]
	push = group user/Khalil jridi (khelilo7)
	push = +force group user/Khalil jridi (khelilo7)
